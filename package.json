{
  "name": "quick-it",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:init": "npx cap add android && node scripts/patch-android.mjs",
    "android:sync": "npm run build && npx cap sync android && node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@capacitor/app": "7.1.0",
    "@capacitor/browser": "7.0.2",
    "@capacitor/core": "7.4.0",
    "@supabase/supabase-js": "2.57.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.7"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.0",
    "@capacitor/cli": "7.4.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
